# ==========================================
# NAMCUMZ PAYMENT CONFIGURATION (.env.example)
# ==========================================

# Payment Provider: sepay | casso | vietqr | mock
PAYMENT_PROVIDER=sepay
PAYMENT_API_URL=https://my.sepay.vn/userapi
PAYMENT_API_KEY=your_api_key_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# Receiving Bank Information (MB Bank, VCB, TCB...)
BANK_BIN=970422
BANK_CODE=MB
BANK_NAME="MB Bank (Ngân hàng Quân Đội)"
BANK_ACCOUNT_NUMBER=0763550673
BANK_ACCOUNT_NAME="NGUYEN HOANG NAM"

# Payment Expiration Window (in minutes)
PAYMENT_EXPIRE_MINUTES=15

# Supabase Credentials (Backend / Serverless functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
